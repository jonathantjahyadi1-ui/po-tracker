DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# DATABASE_URL=postgresql://user:password@host:5432/database
# Di lokal, DATABASE_URL juga dipakai saat DEBUG=true.
# DEV_DATABASE_URL dapat mengarah ke PostgreSQL development terpisah.
DATABASE_SCHEMA=severli
# Untuk memilih SQLite secara eksplisit meski DATABASE_URL terisi:
# LOCAL_DATABASE=severli.sqlite3
# LEGACY_USERS_SCHEMA=po_tracking
DATABASE_SSL=require
